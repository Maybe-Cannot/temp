private static String previewGzipTraceSample(String gzipPath) throws IOException, InterruptedException {
    ProcessBuilder previewBuilder = new ProcessBuilder(
        "/bin/bash",
        "-lc",
        "gzip -dc \"" + gzipPath + "\" | awk 'NR <= 5 {print $0}'"
    );
    previewBuilder.redirectErrorStream(true);
    Process previewProcess = previewBuilder.start();
    try (InputStream input = previewProcess.getInputStream()) {
        String sample = new String(input.readAllBytes(), StandardCharsets.UTF_8);
        previewProcess.waitFor();
        return sample;
    }
}
