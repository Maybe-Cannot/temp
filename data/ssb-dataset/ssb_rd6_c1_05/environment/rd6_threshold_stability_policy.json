{
  "review_mode": "threshold-stability-review",
  "target_video": "input_video.mp4",
  "target_segments_path": "/tmp/all_segments.json",
  "review_phases": [
    {
      "phase": "initial_report_finalize",
      "threshold_multiplier": 1.7,
      "pause_threshold_ratio": 0.55,
      "pause_window_size": 30
    },
    {
      "phase": "reviewer_threshold_rescan",
      "threshold_multiplier": 1.7,
      "pause_threshold_ratio": 0.55,
      "pause_window_size": 30
    },
    {
      "phase": "pause_alignment_rescan",
      "threshold_multiplier": 1.7,
      "pause_threshold_ratio": 0.55,
      "pause_window_size": 30
    }
  ],
  "stop_after_cycles": 3,
  "termination_reason": "stability-review-complete"
}
